<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Model download + optional embedded HTTP API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground recording service so capture survives backgrounding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Required by MediaProjection for the optional system-audio capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Keep the CPU awake while transcribing with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Post the ongoing recording notification (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Transcriber">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Transcriber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".MediaProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
