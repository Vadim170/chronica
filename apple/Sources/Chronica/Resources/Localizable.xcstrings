    "diag.droppedAudio.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some audio did not make it into processing. Normally this line is absent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть звука не успела попасть в обработку. В норме этой строки нет."
          }
        }
      }
    },
    "diag.droppedIntervals.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These intervals were not recognized and never reached the history. Normally this line is absent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти интервалы не были распознаны и в историю не попали. В норме этой строки нет."
