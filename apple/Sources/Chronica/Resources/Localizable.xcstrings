    "vision.prompt.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a screenshot of a person at work. %@\nDescribe in 1–2 sentences in English what work is being done: the gist of the action and which document/code/page/conversation it concerns. Only facts visible on the screen, no reasoning and no preamble."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это скриншот экрана работающего человека. %@\nОпиши в 1–2 предложениях по-русски, какая работа выполняется: суть действия, над каким документом/кодом/страницей/перепиской. Только факты с экрана, без рассуждений и вступлений."
          }
        }
      }
    },
