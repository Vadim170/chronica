    "diag.cpu.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can exceed 100% with several threads — just like in Activity Monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может превышать 100% при нескольких потоках — как в «Мониторинге системы»."
