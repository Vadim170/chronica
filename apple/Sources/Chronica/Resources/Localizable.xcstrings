    "settings.screen.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronica will take a screenshot from time to time, a local model will describe it in one phrase, and the screenshot is deleted right away. Neither images nor descriptions leave this computer. Requires the Screen Recording permission and a running Ollama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronica будет периодически делать снимок экрана, локальная модель опишет его одной фразой, а сам снимок сразу удаляется. Ни изображения, ни описания не покидают этот компьютер. Нужны разрешение «Запись экрана» и установленная Ollama."
          }
        }
      }
    },
