    "error.queueDrop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: the recognizer could not keep up with an interval (lost: %lld). Recording continues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждение: ASR не успел обработать интервал (потеряно: %lld). Запись продолжается."
          }
        }
      }
    },
    "error.relaunchFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start a new Chronica process. The current recording has already stopped; try restarting again."
